{
  "version": 6,
  "configurePresets": [
    {
      "name": "win-msvc-x64-base",
      "hidden": true,
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "win-msvc-x64-debug",
      "displayName": "Windows MSVC x64 Debug",
      "description": "使用 MSVC 编译器和 Ninja 构建 (Debug)",
      "inherits": "win-msvc-x64-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/out/build/win-msvc-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-msvc-x64-release",
      "displayName": "Windows MSVC x64 Release",
      "description": "使用 MSVC 编译器和 Ninja 构建 (Release)",
      "inherits": "win-msvc-x64-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/out/build/win-msvc-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mac-llvm-x64-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}"
    },
    {
      "name": "mac-llvm-x64-debug",
      "displayName": "MacOS x64 Debug",
      "description": "使用 LLVM 编译器和 Ninja 构建 (Debug)",
      "inherits": "mac-llvm-x64-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mac-llvm-x64-release",
      "displayName": "MacOS x64 Release",
      "description": "使用 LLVM 编译器和 Ninja 构建 (Release)",
      "inherits": "mac-llvm-x64-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}